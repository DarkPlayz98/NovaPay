DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client configuration (optional for sign-in UI)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NovaPay-owned network configuration.
# Keep the shared secret server-side only. Never expose it as NEXT_PUBLIC_*.
NOVAPAY_NETWORK_ID=novapay-in
NOVAPAY_NETWORK_STATUS=NOT_AUTHORIZED
NOVAPAY_NETWORK_SHARED_SECRET=replace-with-a-long-random-server-secret
